# Generate secrets with: openssl rand -hex 32
# For KEY_ENCRYPTION_SECRET, you MUST use exactly 64 hex characters.

PORT=3000
DB_USER=postgres
DB_PASSWORD=__REPLACE_ME__
DB_NAME=whatsapp_gateway
DB_PORT=5433
DB_HOST=localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_ME__
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:__REPLACE_ME__@localhost:5433/whatsapp_gateway

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=__REPLACE_ME__
JWT_SECRET=__REPLACE_ME__

# API key encryption (64 hex chars = 32 bytes)
KEY_ENCRYPTION_SECRET=__REPLACE_ME__

# Webhook signing
WEBHOOK_SIGNING_SECRET=

# Webhook security
WEBHOOK_ALLOW_HTTP=false

# Security / Deployment
NODE_ENV=development
TRUST_PROXY=loopback
CORS_ORIGINS=

# Endpoint access control
METRICS_PUBLIC=false
METRICS_TOKEN=__REPLACE_ME__
DOCS_PUBLIC=false
